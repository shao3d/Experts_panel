# ==========================================
# Experts Panel - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values
# NEVER commit .env file to version control!

# ======================
# REQUIRED VARIABLES
# ======================

# OpenRouter runtime authentication. Keep this only in a secret store or local
# backend/.env; never commit the key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Database Configuration
# SQLite database path (relative to project root)
DATABASE_URL=sqlite:///data/experts.db

# Agent Context API (explicit-only agent surface)
# Use a separate read-only token; do not reuse ADMIN_SECRET.
AGENT_CONTEXT_API_TOKEN=
AGENT_CONTEXT_API_URL=http://localhost:8000/api/v1/agent/context
AGENT_CONTEXT_RATE_LIMIT_PER_MINUTE=10
AGENT_CONTEXT_TIMEOUT_SECONDS=3600
AGENT_CONTEXT_MAX_RESPONSE_BYTES=100000000
AGENT_CONTEXT_RESULTS_DIR=
AGENT_CONTEXT_RESULTS_TTL_DAYS=7

# Optional expert_digest caps.
# 0 means "all selected evidence" for evidence count/char caps.
AGENT_CONTEXT_DIGEST_MAX_SOURCE_REFS=0
AGENT_CONTEXT_DIGEST_MAX_SOURCE_CHARS=0
AGENT_CONTEXT_DIGEST_MAX_COMMENTS_PER_SOURCE=0
AGENT_CONTEXT_DIGEST_MAX_COMMENT_CHARS=0
AGENT_CONTEXT_DIGEST_MAX_LINKS_PER_SOURCE=0
AGENT_CONTEXT_DIGEST_MAX_SIGNALS=0
AGENT_CONTEXT_DIGEST_MAX_OUTPUT_TOKENS=16384

# Optional local panex CLI artifact storage.
PANEX_ARTIFACT_DIR=
PANEX_ARTIFACT_TTL_DAYS=7

# ======================
# TELEGRAM API CONFIGURATION
# ======================

# Telegram API Credentials
# Get from: https://my.telegram.org (API Development Tools)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your-telegram-api-hash-here
TELEGRAM_PHONE=+1234567890

# Channel to sync
TELEGRAM_CHANNEL=nobilix

# Sync Configuration
# Number of recent posts to check for new comments on each sync
# Covers ~30 days of posts (catches delayed comments on older posts)
SYNC_DEPTH=10

# Session file name (without .session extension)
TELEGRAM_SESSION_NAME=telegram_fetcher

# Optional explicit path used by sync orchestrator
TELEGRAM_SESSION_PATH=

# ======================
# APPLICATION MODE
# ======================

ENVIRONMENT=development

# ======================
# PIPELINE CONFIGURATION
# ======================

# 10-phase pipeline + sidecars.
# Values below mirror current defaults in backend/src/config.py unless noted.
MAP_CHUNK_SIZE=50
MAP_MAX_PARALLEL=25
MAX_CONCURRENT_EXPERTS=5
META_SYNTHESIS_TIMEOUT_SECONDS=120

# Durable UI query result artifacts.
# Empty QUERY_RESULTS_DIR defaults to query_results/ next to BACKEND_LOG_FILE.
QUERY_RESULTS_DIR=
QUERY_RESULTS_TTL_DAYS=7

# Medium Posts Scoring Configuration
MEDIUM_SCORE_THRESHOLD=0.7
MEDIUM_MAX_SELECTED_POSTS=5
MEDIUM_MAX_POSTS=50

# Hybrid Retrieval
MODEL_EMBEDDING=google/gemini-embedding-001
EMBEDDING_DIMENSIONS=768
HYBRID_VECTOR_TOP_K=150
HYBRID_FTS5_TOP_K=100
HYBRID_RRF_K=60
MAX_FTS_RESULTS=300
USE_SUPER_PASSPORT_DEFAULT=false
FTS5_CIRCUIT_BREAKER_THRESHOLD=3

# ===================================================================
# >>>           MODEL CONFIGURATION (Gemini Only)            <<<
# ===================================================================
# All LLM operations use Vertex AI.
# Gemini 3 family models are routed through the Vertex global endpoint by the unified client.
# This is the single place to manage which models are used.

# Model for Map phase (lightweight, fast)
MODEL_MAP=google/gemini-2.5-flash-lite

# Model for Synthesis (Reduce) and Comment Synthesis phases
MODEL_SYNTHESIS=google/gemini-3-flash-preview

# Model for Analysis (Translation, Validation)
MODEL_ANALYSIS=google/gemini-3.1-flash-lite

# Model for Medium Scoring
MODEL_MEDIUM_SCORING=google/gemini-3.1-flash-lite

# Model for finding Comment Groups
MODEL_COMMENT_GROUPS=google/gemini-3.1-flash-lite

# Model for offline Drift Analysis (cron jobs)
# Uses gemini-3-flash-preview for Pro-grade reasoning
MODEL_DRIFT_ANALYSIS=google/gemini-3-flash-preview

# Model for Meta-Synthesis (cross-expert unified analysis)
# Runs only when 2+ experts respond. Synthesizes unified executive summary.
MODEL_META_SYNTHESIS=google/gemini-3-flash-preview

# Model for AI Scout (FTS5 query generation for Hybrid Search).
# Must be a model name that is reachable on Vertex AI for this project.
# Previously `gemini-3.1-flash-lite-preview` silently returned 404 here
# and degraded Scout to a wide keyword fallback that blew up retrieval
# latency — keep it on the gemini-2.5 family that MODEL_MAP already uses.
MODEL_SCOUT=google/gemini-3.1-flash-lite

# Models for Video Hub Sidecar (Digital Twin)
MODEL_VIDEO_PRO=gemini-3.1-pro-preview
MODEL_VIDEO_FLASH=gemini-3-flash-preview

# Logging
LOG_LEVEL=INFO
BACKEND_LOG_FILE=data/backend.log
FRONTEND_LOG_FILE=data/frontend.log

# Reddit Search V2 (precision-first)
REDDIT_SEARCH_DEBUG=false
REDDIT_RERANK_CANDIDATES=18
REDDIT_PRE_RERANK_ENRICH_LIMIT=18
REDDIT_MIN_CONFIDENCE=0.52
REDDIT_SOFT_CONFIDENCE=0.44
# Synthesis context budget: top-K comment roots per source and per-source
# char cap shared between post body and its discussion tree
REDDIT_SYNTH_COMMENT_TOP_K=12
REDDIT_SYNTH_SOURCE_CHAR_CAP=15000
# Synthesis output budget; finish_reason=length auto-retries once at 2x
REDDIT_SYNTH_MAX_TOKENS=4096
# Serper.dev Google SERP discovery (site:reddit.com via real Google)
# 1 credit per search <=10 results; free tier 2500 queries. Optional.
# SERPER_API_KEY=
SERPER_RESULTS=8

# Arctic Shift archive discovery (free, no keys; per-subreddit full-text)
ARCTIC_SHIFT_ENABLED=true
ARCTIC_TARGET_SUBREDDITS=2
ARCTIC_LIMIT_PER_SUB=12

# Reddit proxy sidecar URL (docker compose service name; override for local dev)
REDDIT_PROXY_URL=http://reddit-proxy:3000

# ==================================
# Optional: Production Configuration
# ==================================
PRODUCTION_ORIGIN=https://your-production-domain.com
ADMIN_SECRET=change-me-for-admin-endpoints

# ======================
# OPTIONAL VARIABLES
# ======================

# Optional frontend admin header (used by Vite frontend/debug tooling)
VITE_ADMIN_SECRET=
